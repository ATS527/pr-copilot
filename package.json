{
  "name": "pull-request-review-vscode",
  "displayName": "Pull Request Review",
  "description": "Review pull requests inside VS Code with native navigation.",
  "version": "0.0.1",
  "publisher": "startup-ideas",
  "icon": "media/pr-copilot.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ATS527/pr-copilot"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "SCM",
    "Programming Languages"
  ],
  "activationEvents": [
    "onCommand:prCopilot.openPr",
    "onCommand:prCopilot.refreshPullRequests",
    "onCommand:prCopilot.checkoutPr",
    "onCommand:prCopilot.restoreBranch",
    "onCommand:prCopilot.setScmToken",
    "onCommand:prCopilot.clearScmToken",
    "onCommand:prCopilot.setGitHubToken",
    "onCommand:prCopilot.clearGitHubToken",
    "onCommand:prCopilot.createPullRequest",
    "onCommand:prCopilot.mergePullRequest",
    "onCommand:prCopilot.closePullRequest",
    "onCommand:prCopilot.editPullRequestMetadata",
    "onCommand:prCopilot.addReviewComment",
    "onCommand:prCopilot.submitReview",
    "onCommand:prCopilot.openReviewDraft",
    "onCommand:prCopilot.removeReviewComment",
    "onCommand:prCopilot.clearReviewComments",
    "onCommand:prCopilot.refreshIssues",
    "onCommand:prCopilot.refreshChecks",
    "onCommand:prCopilot.refreshSecurity",
    "onCommand:prCopilot.showLogs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "prCopilot.openPr",
        "title": "Pull Request Review: Open PR",
        "icon": "$(repo-pull)"
      },
      {
        "command": "prCopilot.refreshPullRequests",
        "title": "Pull Request Review: Refresh Pull Requests",
        "icon": "$(refresh)"
      },
      {
        "command": "prCopilot.checkoutPr",
        "title": "Pull Request Review: Checkout Pull Request"
      },
      {
        "command": "prCopilot.restoreBranch",
        "title": "Pull Request Review: Restore Previous Branch"
      },
      {
        "command": "prCopilot.setScmToken",
        "title": "Pull Request Review: Set SCM Token",
        "icon": "$(key)"
      },
      {
        "command": "prCopilot.clearScmToken",
        "title": "Pull Request Review: Clear SCM Token",
        "icon": "$(trash)"
      },
      {
        "command": "prCopilot.setGitHubToken",
        "title": "Pull Request Review: Set GitHub Token",
        "icon": "$(key)"
      },
      {
        "command": "prCopilot.clearGitHubToken",
        "title": "Pull Request Review: Clear GitHub Token",
        "icon": "$(trash)"
      },
      {
        "command": "prCopilot.createPullRequest",
        "title": "Pull Request Review: Create Pull Request",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "prCopilot.mergePullRequest",
        "title": "Pull Request Review: Merge Pull Request",
        "icon": "$(git-merge)"
      },
      {
        "command": "prCopilot.closePullRequest",
        "title": "Pull Request Review: Close Pull Request",
        "icon": "$(close)"
      },
      {
        "command": "prCopilot.editPullRequestMetadata",
        "title": "Pull Request Review: Edit Pull Request Metadata",
        "icon": "$(edit)"
      },
      {
        "command": "prCopilot.addReviewComment",
        "title": "Pull Request Review: Add Review Comment",
        "icon": "$(comment)"
      },
      {
        "command": "prCopilot.submitReview",
        "title": "Pull Request Review: Submit Review",
        "icon": "$(checklist)"
      },
      {
        "command": "prCopilot.openReviewDraft",
        "title": "Pull Request Review: Open Review Draft"
      },
      {
        "command": "prCopilot.removeReviewComment",
        "title": "Pull Request Review: Remove Review Comment",
        "icon": "$(trash)"
      },
      {
        "command": "prCopilot.clearReviewComments",
        "title": "Pull Request Review: Clear Review Comments",
        "icon": "$(clear-all)"
      },
      {
        "command": "prCopilot.refreshIssues",
        "title": "Pull Request Review: Refresh Issues",
        "icon": "$(refresh)"
      },
      {
        "command": "prCopilot.refreshChecks",
        "title": "Pull Request Review: Refresh Checks",
        "icon": "$(refresh)"
      },
      {
        "command": "prCopilot.refreshSecurity",
        "title": "Pull Request Review: Refresh Security Findings",
        "icon": "$(refresh)"
      },
      {
        "command": "prCopilot.showLogs",
        "title": "Pull Request Review: Show Logs",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "prCopilot.openPr",
          "when": "view == prCopilot.pullRequests",
          "group": "navigation@1"
        },
        {
          "command": "prCopilot.refreshPullRequests",
          "when": "view == prCopilot.pullRequests",
          "group": "navigation@2"
        },
        {
          "command": "prCopilot.setScmToken",
          "when": "view == prCopilot.pullRequests",
          "group": "settings@1"
        },
        {
          "command": "prCopilot.clearScmToken",
          "when": "view == prCopilot.pullRequests",
          "group": "settings@2"
        },
        {
          "command": "prCopilot.createPullRequest",
          "when": "view == prCopilot.pullRequests",
          "group": "actions@3"
        },
        {
          "command": "prCopilot.mergePullRequest",
          "when": "view == prCopilot.pullRequests",
          "group": "actions@4"
        },
        {
          "command": "prCopilot.closePullRequest",
          "when": "view == prCopilot.pullRequests",
          "group": "actions@5"
        },
        {
          "command": "prCopilot.editPullRequestMetadata",
          "when": "view == prCopilot.pullRequests",
          "group": "actions@6"
        },
        {
          "command": "prCopilot.addReviewComment",
          "when": "view == prCopilot.pullRequests",
          "group": "actions@7"
        },
        {
          "command": "prCopilot.submitReview",
          "when": "view == prCopilot.pullRequests",
          "group": "actions@8"
        },
        {
          "command": "prCopilot.clearReviewComments",
          "when": "view == prCopilot.reviewDrafts",
          "group": "navigation@1"
        },
        {
          "command": "prCopilot.showLogs",
          "when": "view == prCopilot.pullRequests",
          "group": "settings@1"
        },
        {
          "command": "prCopilot.refreshIssues",
          "when": "view == prCopilot.issues",
          "group": "navigation@1"
        },
        {
          "command": "prCopilot.refreshChecks",
          "when": "view == prCopilot.checks",
          "group": "navigation@1"
        },
        {
          "command": "prCopilot.refreshSecurity",
          "when": "view == prCopilot.security",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "prCopilot.removeReviewComment",
          "when": "view == prCopilot.reviewDrafts && viewItem == reviewDraft",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prCopilot",
          "title": "Pull Requests",
          "icon": "media/pr-copilot.svg"
        }
      ]
    },
    "views": {
      "prCopilot": [
        {
          "id": "prCopilot.pullRequests",
          "name": "Pull Requests"
        },
        {
          "id": "prCopilot.issues",
          "name": "Issues"
        },
        {
          "id": "prCopilot.checks",
          "name": "Checks"
        },
        {
          "id": "prCopilot.security",
          "name": "Security"
        },
        {
          "id": "prCopilot.reviewDrafts",
          "name": "Review Drafts"
        }
      ]
    },
    "configuration": {
      "title": "Pull Request Review",
      "properties": {
        "prCopilot.provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab"
          ],
          "default": "github",
          "description": "Select the SCM provider for fetching pull requests."
        },
        "prCopilot.github.requireToken": {
          "type": "boolean",
          "default": false,
          "description": "Require a GitHub personal access token before fetching pull requests."
        },
        "prCopilot.github.pullRequestQuery": {
          "type": "string",
          "default": "",
          "description": "Optional additional GitHub search qualifiers for filtering pull requests."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "lint": "eslint src --ext .ts",
    "package": "node_modules/@vscode/vsce/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2"
  }
}
